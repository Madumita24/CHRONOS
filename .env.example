# Optional explicit overrides. When either value is absent, CHRONOS fills
# missing values from the standard DataHub CLI profile created by datahub init.
# DATAHUB_GMS_URL=http://localhost:8080
# DATAHUB_TOKEN=replace-with-a-read-only-personal-access-token

# Optional runtime settings.
DATAHUB_TIMEOUT_SECONDS=10
CHRONOS_LOG_LEVEL=INFO

# Integration tests are skipped unless explicitly enabled.
CHRONOS_RUN_INTEGRATION=0
